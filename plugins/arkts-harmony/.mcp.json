{
  "mcpServers": {
    "arkts-knowledge-search": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@rvaim/arkts_knowledge_search"
      ]
    },
    "deveco-cli": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@deveco/deveco-cli",
        "serve",
        "mcp"
      ]
    },
    "deveco-arkts-lsp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@rvaim/deveco-arkts-lsp"
      ]
    },
    "deveco-mobile-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@rvaim/deveco-mobile-mcp"
      ]
    },
    "harmonyos-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "harmonyos-mcp"
      ]
    }
  }
}
