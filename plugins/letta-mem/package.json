{
  "name": "letta-mem",
  "version": "2.10.9",
  "description": "将编码会话与记忆作用域约束交给 Letta Agent 自主管理持久记忆",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:windows-launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-launcher.ps1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:windows-hook": "node scripts/verify-windows-hook-launcher.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@letta-ai/letta-agent-sdk": "0.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "esbuild": "^0.25.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
