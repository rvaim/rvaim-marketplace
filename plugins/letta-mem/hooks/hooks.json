{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" session-state",
            "timeout": 2,
            "statusMessage": "正在恢复 Letta 记忆状态"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" inject-context",
            "timeout": 40,
            "statusMessage": "正在向 Letta Agent 获取相关记忆"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" sync-context",
            "timeout": 10,
            "statusMessage": "正在同步 Letta 后台上下文"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" update-memory-background",
            "timeout": 10,
            "statusMessage": "正在后台更新 Letta 记忆"
          }
        ]
      }
    ]
  }
}
