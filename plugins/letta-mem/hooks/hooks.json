{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" prepare-session-background",
            "commandWindows": "& \"${CLAUDE_PLUGIN_ROOT}/bin/invoke-hook.ps1\" -NoHostStdin --background prepare-session-worker; exit $LASTEXITCODE",
            "timeout": 2,
            "statusMessage": "正在后台准备 Letta 记忆"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" inject-context",
            "commandWindows": "& \"${CLAUDE_PLUGIN_ROOT}/bin/invoke-hook.ps1\" inject-context; exit $LASTEXITCODE",
            "timeout": 40,
            "statusMessage": "正在读取 Letta 已准备的记忆指导"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" sync-context",
            "commandWindows": "& \"${CLAUDE_PLUGIN_ROOT}/bin/invoke-hook.ps1\" sync-context; exit $LASTEXITCODE",
            "timeout": 10,
            "statusMessage": "正在检查 Letta 最新记忆指导"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" update-memory-background",
            "commandWindows": "& \"${CLAUDE_PLUGIN_ROOT}/bin/invoke-hook.ps1\" update-memory-background; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & \"${CLAUDE_PLUGIN_ROOT}/bin/invoke-hook.ps1\" --background drain-background; exit $LASTEXITCODE",
            "timeout": 10,
            "statusMessage": "正在后台更新 Letta 记忆"
          }
        ]
      }
    ]
  }
}
