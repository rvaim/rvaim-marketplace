{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" prepare-session-background",
            "commandWindows": "$null = Start-Process -FilePath \"${CLAUDE_PLUGIN_ROOT}/bin/letta-mem-hook-launcher.exe\" -ArgumentList @(\"--background\", \"prepare-session-worker\") -NoNewWindow; exit 0",
            "timeout": 2,
            "statusMessage": "正在后台准备 Letta 记忆"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" inject-context",
            "commandWindows": "$p = Start-Process -FilePath \"${CLAUDE_PLUGIN_ROOT}/bin/letta-mem-hook-launcher.exe\" -ArgumentList \"inject-context\" -NoNewWindow -Wait -PassThru; exit $p.ExitCode",
            "timeout": 40,
            "statusMessage": "正在读取 Letta 已准备的记忆指导"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" sync-context",
            "commandWindows": "$p = Start-Process -FilePath \"${CLAUDE_PLUGIN_ROOT}/bin/letta-mem-hook-launcher.exe\" -ArgumentList \"sync-context\" -NoNewWindow -Wait -PassThru; exit $p.ExitCode",
            "timeout": 10,
            "statusMessage": "正在检查 Letta 最新记忆指导"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.cjs\" update-memory-background",
            "commandWindows": "$p = Start-Process -FilePath \"${CLAUDE_PLUGIN_ROOT}/bin/letta-mem-hook-launcher.exe\" -ArgumentList \"update-memory-background\" -NoNewWindow -Wait -PassThru; if ($p.ExitCode -ne 0) { exit $p.ExitCode }; $null = Start-Process -FilePath \"${CLAUDE_PLUGIN_ROOT}/bin/letta-mem-hook-launcher.exe\" -ArgumentList @(\"--background\", \"drain-background\") -NoNewWindow; exit 0",
            "timeout": 10,
            "statusMessage": "正在后台更新 Letta 记忆"
          }
        ]
      }
    ]
  }
}
